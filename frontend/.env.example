# Supabase Auth (https://supabase.com/dashboard/project/_/settings/api)
# Copy to .env and fill in. Leave empty for demo mode (guest sign-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps API Key
# Requires the Maps JavaScript API to be enabled in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=

# ── Server ──────────────────────────────────────────────
PORT=5100
JWT_SECRET=sevanest-admin-jwt-secret-key-2026
ESCALATION_DAYS=7

# ── PostgreSQL (Prisma) ─────────────────────────────────
# All app data (schemes, users, complaints, …) lives in your Supabase project's
# Postgres database. Get the URI at: Supabase Dashboard → Project Settings →
# Database → "Connection string" → URI. The Transaction pooler (port 6543,
# pgbouncer=true) is recommended for Prisma; the direct connection (port 5432)
# also works.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Supabase auth ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── AI chat (Groq first, Gemini fallback) ───────────────
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Voice (Sarvam AI speech-to-text) ────────────────────
# Get a key at https://dashboard.sarvam.ai (Speech → API keys).
# Without it the chat voice button falls back to the browser's
# built-in speech recognition (English only).
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5

# ── Optional data ingestion ─────────────────────────────
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=
MYSCHEME_API_URL=

# ── Server ──────────────────────────────────────────────
PORT=5100

# ── PostgreSQL (Prisma) ─────────────────────────────────
# All app data (schemes, users, complaints, documents, …) lives in your
# Supabase project's Postgres database. Get the URI at: Supabase Dashboard →
# Project Settings → Database → "Connection string" → URI. The Transaction
# pooler (port 6543, pgbouncer=true) is recommended for Prisma; the direct
# connection (port 5432) also works.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Optional AI + ingestion adapters (gracefully skipped if absent) ──
GEMINI_API_KEY=
MYSCHEME_API_URL=
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=

# ── Supabase auth ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── AI chat (Groq first, Gemini fallback) ───────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Voice (Sarvam AI speech-to-text) ────────────────────
# Get a key at https://dashboard.sarvam.ai (Speech → API keys).
# Without it the chat voice button falls back to the browser's
# built-in speech recognition (English only).
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5

# ── Supabase Storage (citizen document uploads) ─────────
# Service-role secret for server-side Storage uploads (Supabase Dashboard →
# Settings → API → service_role). Documents go into a private bucket and are
# served via signed URLs. Leave empty to keep using the local uploads/ folder.
SUPABASE_SERVICE_ROLE_KEY=

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum ComplaintStatus {
  SUBMITTED
  ACKNOWLEDGED
  DEPARTMENT_ASSIGNED
  INVESTIGATION_IN_PROGRESS
  ACTION_TAKEN
  RESOLVED
  CLOSED
  REOPENED
  MORE_INFO_REQUIRED
  ESCALATED
  OPEN
  PENDING
  ASSIGNED
  IN_PROGRESS
}

model Scheme {
  id                String    @id @default(uuid())
  externalId        String?   @map("external_id")
  source            String    @default("system")
  sourceUrl         String?   @map("source_url")
  sourceLastUpdated DateTime? @map("source_last_updated")
  
  title             String
  category          String
  tag               String?
  description       String    @db.Text
  benefit           String
  eligibility       String    @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  applicationsCount Int       @default(0) @map("applications_count")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([source, externalId], name: "source_external_id")
  @@index([category])
  @@index([title])
  @@map("schemes")
}

model Department {
  id          String        @id @default(uuid())
  name        String        @unique
  code        String?
  description String?
  complaints  Complaint[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id                 String                   @id @default(uuid())
  supabaseId         String?                  @unique @map("supabase_id")
  email              String?                  @unique
  fullName           String                   @map("full_name")
  phone              String?
  passwordHash       String?                  @map("password_hash")
  role               Role                     @default(CITIZEN)
  gender             String?
  age                Int?
  state              String?
  casteCategory      String?                  @map("caste_category")
  annualIncome       Float?                   @map("annual_income")
  occupation         String?
  incomeSource       String?                  @map("income_source")
  landAcres          Float?                   @map("land_acres")
  village            String?
  block              String?
  district           String?

  familyMembers      FamilyMember[]
  documents          CitizenDocument[]
  complaints         Complaint[]              @relation("CitizenComplaints")
  assignedComplaints Complaint[]              @relation("AssignedOfficerComplaints")
  authoredRemarks    ComplaintRemark[]        @relation("AuthoredRemarks")
  statusChanges      ComplaintStatusHistory[] @relation("StatusChanges")

  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

model CitizenDocument {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // aadhaar | voter_id | income_certificate | ration_card | bank_passbook | land_record
  docType   String   @map("doc_type")
  fileName  String   @map("file_name")
  fileUrl   String?  @map("file_url")
  status    String   @default("PENDING") // PENDING (uploaded) | VERIFIED (records cross-check passed)
  note      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, docType])
  @@index([userId])
  @@map("citizen_documents")
}

model FamilyMember {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName      String   @map("full_name")
  relation      String   // Father, Mother, Spouse, Son, Daughter, Brother, Sister, Dependent Senior, Other
  dob           String?  // Date of Birth (YYYY-MM-DD)
  age           Int
  gender        String   // Male, Female, Other
  state         String   @default("WEST_BENGAL")
  residenceType String   @default("RURAL") @map("residence_type") // Rural, Urban
  occupation    String   // Farmer, Daily Wage Worker, Salaried, Student, Unemployed, Retired, Small Business, Homemaker
  annualIncome  Float    @default(0) @map("annual_income")
  isStudent     Boolean  @default(false) @map("is_student")
  isDisability  Boolean  @default(false) @map("is_disability")
  landAcres     Float    @default(0) @map("land_acres")
  notes         String?

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("family_members")
}

model Complaint {
  id                   String                   @id @default(uuid())
  ref                  String                   @unique
  trackingPin          String?                  @map("tracking_pin")
  title                String
  description          String?                  @db.Text
  location             String
  latitude             Float?
  longitude            Float?
  category             String                   @default("OTHER")
  priority             String                   @default("LOW")
  photoUrl             String?                  @map("photo_url")
  videoUrl             String?                  @map("video_url")
  status               ComplaintStatus          @default(SUBMITTED)

  isEscalated          Boolean                  @default(false) @map("is_escalated")
  escalationLevel      Int                      @default(0) @map("escalation_level")
  escalatedAt          DateTime?                @map("escalated_at")
  
  userId               String?                  @map("user_id")
  user                 User?                    @relation("CitizenComplaints", fields: [userId], references: [id], onDelete: SetNull)

  assignedDepartmentId String?                  @map("assigned_department_id")
  assignedDepartment   Department?              @relation(fields: [assignedDepartmentId], references: [id], onDelete: SetNull)

  assignedOfficerId    String?                  @map("assigned_officer_id")
  assignedOfficer      User?                    @relation("AssignedOfficerComplaints", fields: [assignedOfficerId], references: [id], onDelete: SetNull)

  remarks              ComplaintRemark[]
  statusHistory        ComplaintStatusHistory[]
  evidence             ComplaintEvidence[]
  inquiries            ComplaintInquiry[]
  notifications        Notification[]

  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@map("complaints")
}

model ComplaintEvidence {
  id          String    @id @default(uuid())
  complaintId String    @map("complaint_id")
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  mediaUrl    String    @map("media_url")
  mediaType   String    @map("media_type")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([complaintId])
  @@map("complaint_evidence")
}

model ComplaintRemark {
  id          String    @id @default(uuid())
  complaintId String    @map("complaint_id")
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  adminId     String?   @map("admin_id")
  admin       User?     @relation("AuthoredRemarks", fields: [adminId], references: [id], onDelete: SetNull)
  remark      String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("complaint_remarks")
}

model ComplaintStatusHistory {
  id             String    @id @default(uuid())
  complaintId    String    @map("complaint_id")
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  previousStatus String?   @map("previous_status")
  newStatus      String    @map("new_status")
  changedById    String?   @map("changed_by_id")
  changedBy      User?     @relation("StatusChanges", fields: [changedById], references: [id], onDelete: SetNull)
  remark         String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("complaint_status_histories")
}

model ComplaintInquiry {
  id          String                    @id @default(uuid())
  complaintId String                    @map("complaint_id")
  complaint   Complaint                 @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  subject     String
  status      String                    @default("OPEN") // OPEN | RESOLVED
  messages    ComplaintInquiryMessage[]
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  @@index([complaintId])
  @@map("complaint_inquiries")
}

model ComplaintInquiryMessage {
  id            String           @id @default(uuid())
  inquiryId     String           @map("inquiry_id")
  inquiry       ComplaintInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderType    String           @map("sender_type") // ADMIN | CITIZEN
  senderName    String           @map("sender_name")
  message       String           @db.Text
  attachmentUrl String?          @map("attachment_url")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([inquiryId])
  @@map("complaint_inquiry_messages")
}

model Notification {
  id          String     @id @default(uuid())
  complaintId String?    @map("complaint_id")
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  targetType  String     @map("target_type") // CITIZEN | ADMIN
  type        String     // INQUIRY_REQUESTED | INQUIRY_REPLIED | STATUS_UPDATED | RESOLUTION_CONFIRMED
  title       String
  message     String     @db.Text
  isRead      Boolean    @default(false) @map("is_read")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("notifications")
}
